---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import linkOutImg from "/src/images/index/link-out.jpg";

interface Props {
  img: ImageMetadata;
  imgStyle?: string;
  text: string;
  href: string;
  class?: string;
}

const { img, imgStyle, text, href, class: gridClass } = Astro.props;

const linksOut = href.startsWith("http");

const textShadow =
  "[text-shadow:-1px_-1px_0_#555555,1px_-1px_0_#555555,-1px_1px_0_#555555,1px_1px_0_#555555,0px_0px_2px_black]";
---

<!-- use button for double click functionality (a does not provide this easily) -->
<button
  data-href={href}
  class={`relative z-10 flex aspect-square w-full max-h-full flex-col gap-0 items-center self-center border-[3px] border-solid border-transparent bg-transparent p-[10%] hover:cursor-default focus-within:rounded-[3px] focus-within:border-[rgb(115,147,179,0.7)] focus-within:bg-[rgb(163,217,271,0.5)] ${gridClass ?? ""}`}
>
  <Image
    src={img}
    alt={text}
    width="400"
    class="relative h-[60%] w-auto rounded-[inherit] opacity-80"
    style={imgStyle}
  />
  <p
    class={`relative text-md mt-auto whitespace-nowrap text-white ${textShadow}`}
  >
    {text}
    {
      linksOut && (
        <Image
          src={linkOutImg}
          alt="links out"
          class="inline-block h-[0.5em] w-[0.5em] align-[-0.1em]"
        />
      )
    }
  </p>
</button>

<script>
  import { initModals } from "@/components/modal/modal.ts";

  document
    .querySelectorAll<HTMLButtonElement>("button[data-href]")
    .forEach((btn) => {
      const href = btn.dataset.href;
      if (!href) return;

      // custom doubleclick functionality to open the game modal
      if (href === "music") {
        btn.addEventListener("dblclick", () => {
          initModals();
          window.openModal("indexModal");
        });
        return;
      }

      // double click to visit
      btn.addEventListener("dblclick", () => {
        href.startsWith("http")
          ? window.open(href)
          : (window.location.href = href);
      });
    });
</script>
