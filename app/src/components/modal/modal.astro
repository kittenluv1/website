---
interface Props {
  id: string;
  draggable?: boolean;
  dimBackdrop?: boolean;
  closeOnBackdrop?: boolean;
}

const {
  id,
  draggable = false,
  dimBackdrop = false,
  closeOnBackdrop = false,
} = Astro.props;

if (!id) {
  throw new Error("Modal component requires an id");
}
---

{
  Astro.slots.has("trigger") && (
    <div data-modal-open={id} class="contents">
      <slot name="trigger" />
    </div>
  )
}

<dialog
  data-modal
  data-modal-id={id}
  data-draggable={draggable ? "true" : "false"}
  data-dim-backdrop={dimBackdrop ? "true" : "false"}
  data-close-on-backdrop={closeOnBackdrop ? "true" : "false"}
  aria-labelledby={`${id}-title`}
  tabindex="-1"
>
  <div data-modal-panel>
    <slot />
  </div>
</dialog>

<script>
  import { initModals } from "./modal.ts";
  initModals();
</script>

<style is:global>
  dialog[data-modal] {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    color: inherit;
  }

  dialog[data-modal]::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  dialog[data-modal][open]:not([data-dim-backdrop="true"]) {
    z-index: 1000;
    pointer-events: auto;
  }

  dialog[data-modal]:focus,
  dialog[data-modal]:focus-visible {
    outline: none;
    box-shadow: none;
  }

  [data-modal-panel] {
    overflow-y: auto;
  }

  dialog[data-modal][data-draggable="true"] [data-modal-panel] {
    cursor: grab;
  }

  dialog[data-modal][data-draggable="true"] [data-modal-drag-handle] {
    cursor: grab;
  }

  .modal-custom-backdrop {
    position: fixed;
    inset: 0;
    z-index: 999;
    border: none;
    padding: 0;
    background: rgb(0 0 0 / 0.75);
    cursor: default;
  }
</style>
