---
import Modal from "@/components/modal/modal.astro";
import { PORTFOLIO_MODAL_ID, type FlatPortfolioProject } from "@/lib/portfolio";

interface Props {
  items: FlatPortfolioProject[];
}

const { items } = Astro.props;
---

<Modal id={PORTFOLIO_MODAL_ID} draggable={false} dimBackdrop={true} closeOnBackdrop={true}>
  {
    items.map((item, index) => (
        <div
          data-portfolio-panel={index}
          class="relative hidden w-full max-w-4xl border border-[#8e8e93] bg-white p-8 text-black dark:border-neutral-500 dark:bg-neutral-900 dark:text-neutral-100"
        >
          <button
            type="button"
            data-modal-close
            class="absolute top-4 right-4 cursor-pointer border-0 bg-transparent p-1 text-2xl leading-none text-[#8e8e93] hover:text-black dark:text-neutral-400 dark:hover:text-neutral-100"
            aria-label="Close"
          >
            ×
          </button>

          <header class="mb-4 flex flex-col gap-2 border-b border-[#8e8e93] pb-3 md:flex-row md:items-end md:justify-between md:gap-4 dark:border-neutral-500">
            <div class="flex min-w-0 flex-nowrap items-end gap-2">
              <h2
                id={`${PORTFOLIO_MODAL_ID}-title`}
                class="min-w-0 text-3xl font-semibold leading-tight md:text-4xl"
              >
                {
                  item.link ? (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex max-w-full items-center gap-1.5 text-inherit no-underline transition-colors hover:text-[#8e8e93] hover:underline dark:hover:text-neutral-400"
                      data-portfolio-name-link
                    >
                      <span class="truncate">{item.name}</span>
                      <span
                        class="shrink-0 text-2xl font-normal italic text-[#8e8e93] md:text-3xl dark:text-neutral-400"
                        aria-hidden="true"
                      >
                        ↗
                      </span>
                    </a>
                  ) : (
                    item.name
                  )
                }
              </h2>
              {
                item.github && (
                  <div class="flex shrink-0 items-center self-stretch">
                    <a
                      href={item.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex size-7 shrink-0 items-center justify-center text-[#8e8e93] transition-opacity hover:opacity-70 -translate-y-[-3px] dark:text-neutral-400"
                      data-portfolio-github-link
                      aria-label={`${item.name} on GitHub`}
                    >
                      <svg viewBox="0 0 16 16" class="size-7 fill-current" aria-hidden="true">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                      </svg>
                    </a>
                  </div>
                )
              }
            </div>
            <p class="shrink-0 text-base italic md:text-right">{item.role}</p>
          </header>

          {
            item.images.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-4">
                {
                  item.images.map((image) => (
                    <img
                      src={image}
                      alt=""
                      class="h-56 max-w-full object-cover md:h-60"
                    />
                  ))
                }
              </div>
            )
          }

          <div class="mb-6 text-md text-[#8e8e93] italic dark:text-neutral-400">
            <p class="not-italic">{item.tagline}</p>
            {item.stack && <p class="mt-2">{item.stack}</p>}
          </div>

          {
            item.details && (
              <div
                class="text-md leading-relaxed [&_p]:mb-3 [&_strong]:font-semibold"
                set:html={item.details}
              />
            )
          }

          {
            item.customComponent && (
              <div data-portfolio-custom={item.customComponent} />
            )
          }
        </div>
      ))
  }
</Modal>

<script>
  import { initPortfolioModal } from "./portfolioModal.ts";
  initPortfolioModal();
</script>

<style is:global>
  dialog[data-modal-id="portfolioModal"] {
    position: fixed;
    inset: 0;
    width: fit-content;
    height: fit-content;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    margin: auto;
    overflow: visible;
    border: none;
    padding: 0;
    background: transparent;
  }

  dialog[data-modal-id="portfolioModal"] [data-modal-panel] {
    position: relative;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  dialog[data-modal-id="portfolioModal"] [data-portfolio-panel]:not(.hidden) {
    display: block;
  }
</style>
