---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import linkOutImg from "/src/images/index/link-out.jpg";

interface Props {
  img: ImageMetadata;
  imgStyle?: string;
  text: string;
  href: string;
  row: number;
  col: number;
}

const { img, imgStyle, text, href, row, col } = Astro.props;

const linksOut = href.startsWith("http");
---

<!-- use button for double click functionality (a does not provide this easily) -->
<button
  data-href={href}
  style={`grid-row-start: ${row}; grid-column-start: ${col};`}
>
  <Image
    src={img}
    alt={text}
    width="400"
    class="index-button-img"
    style={imgStyle}
  />
  <p>
    {text}
    {
      linksOut && (
        <Image src={linkOutImg} alt="links out" class="link-out-img" />
      )
    }
  </p>
</button>

<style>
  button {
    width: 100%;
    background-color: transparent;
    border: none;
    padding: 10%;
    aspect-ratio: 1/1;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  button:focus-within {
    background-color: rgb(163, 217, 271, 0.5);
    border-radius: 1px;
    border: 3px solid rgb(115, 147, 179, 0.7);
  }

  button:hover {
    cursor: default;
  }

  .index-button-img {
    position: absolute;
    border-radius: inherit;
    height: 60%;
    width: auto;
    bottom: 30%;
    opacity: 0.8;
  }

  p {
    position: absolute;
    margin: 0;
    bottom: 10%;
    font-size: 2vh;
    color: white;
    text-shadow:
      -1px -1px 0 #555555,
      1px -1px 0 #555555,
      -1px 1px 0 #555555,
      1px 1px 0 #555555,
      0px 0px 2px black;
  }

  .link-out-img {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("button[data-href]")
    .forEach((btn) => {
      const href = btn.dataset.href;
      if (!href) return;

      // custom doubleclick functionality to open the game modal
      if (href == "music") {
        btn.addEventListener("dblclick", () => {
          window.dispatchEvent(new CustomEvent("toggle-modal"));
        });
        return;
      }

      // double click to visit
      btn.addEventListener("dblclick", () => {
        href.startsWith("http")
          ? window.open(href)
          : (window.location.href = href);
      });
    });
</script>
