---
import "./modal.css";
import Modal from "@/components/modal/modal.astro";
---

<Modal id="indexModal" draggable>
  <div id="index-modal" data-modal-drag-handle>
    <img
      id="tama-shell"
      src="/images/index/modal/shells/0.png"
      draggable="false"
    />
    <button id="heart-btn"></button>
    <div id="screen-div">
      <img class="tama-screen" id="music-image" draggable="false" alt="" />
      <div class="tama-screen" id="instructions">
        <p>%Instructions%</p>
        <ul>
          <li>click and drag to move</li>
          <li>double click to close</li>
          <li>click 'B' to play music</li>
          <li>press ᧔%᧓ to play game</li>
        </ul>
      </div>
      <div class="tama-screen" id="tama-game">
        <div>
          <p>tama jump!</p>
          <img id="mametchi" src="/images/index/modal/mametchi.png" alt="" />
          <div class="score-div flash">
            <p id="score">0</p>
          </div>
          <div class="game-over flash">
            <p>game over!</p>
            <p>press space to play again</p>
          </div>
        </div>
      </div>
    </div>
    <audio id="audio"></audio>
    <button id="previous" type="button">A</button>
    <button id="play" type="button">B</button>
    <button id="next" type="button">C</button>
  </div>
</Modal>
<script src="./modal.js"></script>
