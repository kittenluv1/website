---
import "@/styles/global.css";

const linkClass = "text-blue-600 underline hover:text-blue-800";
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>archive</title>
        <link rel="icon" href="/images/archive/lotus-transparent.png" type="image/png">
    </head>
    <body class="p-6 sm:p-8">
        <a href="/" class={linkClass}>← back</a>
        <ul class="space-y-4">
            <li>
                <a href="portfolio" class={linkClass}>old portfolio</a>
            </li>
            <li class="space-y-2">
                <img
                    src="/images/archive/creations.png"
                    alt="creations"
                    class="block h-auto max-w-sm w-full rounded border border-neutral-300"
                />
                <p class="m-0">
                    old <a href="/creations" class={linkClass}>creations</a> page UI
                </p>
            </li>
        </ul>
    </body>
</html>

<style>
ol, ul > li {
	display: list-item;
	list-style-type: disc;
	list-style-position: inside;
	padding-left: 0.25rem;
}
</style>
