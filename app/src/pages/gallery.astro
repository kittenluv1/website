---
import "@/styles/global.css";
import "@/styles/gallery.css";
import galleryData from "@/data/gallery.json";
import { Image } from "astro:assets";
import Modal from "@/components/modal/modal.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/gallery/*",
  { eager: true },
);

const galleryItems = galleryData.flatMap(({ url, caption }) => {
  const image = images[`/src/images/gallery/${url}`]?.default;
  if (!image) return [];

  return [{ url, caption, image }];
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>photo gallery</title>
    <link
      rel="icon"
      href="/src/images/gallery/tarepanda1.png"
      type="image/png"
    />
  </head>
  <body>
    <div id="loading-screen">
      <Image
        src={images[`/src/images/gallery/tarepanda1.png`]?.default}
        alt="loading..."
        width={600}
        id="loading-image"
      />
      <div id="loading-text">
        <span class="loading-word">loading</span>
        <span class="loading-dots" aria-hidden="true">
          <span class="loading-dot">.</span>
          <span class="loading-dot">.</span>
          <span class="loading-dot">.</span>
        </span>
        <span class="loading-word">please wait</span>
        <span class="loading-dots loading-dots--late" aria-hidden="true">
          <span class="loading-dot">.</span>
          <span class="loading-dot">.</span>
          <span class="loading-dot">.</span>
        </span>
      </div>
    </div>

    <div id="main-content">
      <div id="audio-div">
        <a href="/">&larr; home</a>
        <audio controls src="/audio/music/When someone's mind is in a hurry.mp3"
        ></audio>
        <a href="https://www.youtube.com/watch?v=UMcqpEuMUrs" target="_blank"
          >audio credit. ݁₊ ⊹ . ݁ ⟡ ݁ . ⊹ ₊ ݁.</a
        >
        <p>
          thank you for visiting my photo gallery ⸜(｡˃ ᵕ ˂ )⸝♡-ˋˏ ༻ ❁ ✿ ❀༺ ˎ‧₊˚❀
          ༉ ‧₊ ˚. ☘︎
        </p>
      </div>
      <div id="gallery" class="masonry-grid">
        {
          galleryItems.map(({ caption, image }, index) => (
            <button
              type="button"
              class="masonry-item"
              data-gallery-item={index}
            >
              <Image
                src={image}
                alt={String(caption ?? "")}
                class="gallery-image"
              />
              {caption && <div class="caption">{caption}</div>}
            </button>
          ))
        }
      </div>
    </div>

    <Modal id="galleryModal" dimBackdrop closeOnBackdrop>
      <figure id="gallery-modal-content">
        <img id="gallery-modal-image" alt="" />
        <figcaption id="gallery-modal-caption" hidden></figcaption>
      </figure>
    </Modal>

    <script>
      // SCRIPT: wait for images in initial viewport to load, then remove loading page

      // add promise to each image
      const imagePromise = (img: HTMLImageElement) => {
        if (img.complete) return Promise.resolve();

        return new Promise<void>((resolve) => {
          img.addEventListener("load", () => resolve(), { once: true });
          img.addEventListener("error", () => resolve(), { once: true });
        });
      };
      // filter to only images in initial viewport
      const inInitialViewport = (img: HTMLImageElement) => {
        const rect = img.getBoundingClientRect();
        return rect.top < window.innerHeight && rect.bottom > 0;
      };
      // remove loading ui
      const showPage = () => {
        const loadingScreen = document.getElementById("loading-screen");
        const mainContent = document.getElementById("main-content");

        mainContent!.classList.add("visible");
        loadingScreen!.classList.add("hidden");
        // remove loader from layout after transition
        setTimeout(() => {
          loadingScreen!.style.display = "none";
          document.querySelector("body").style.overflowY = "visible";
        }, 400);
      };
      const init = async () => {
        // only wait on gallery grid images — not the modal or loading screen
        const imageNodes = Array.from(
          document.querySelectorAll("#gallery img.gallery-image"),
        );
        const initialImages = imageNodes.filter((img) =>
          inInitialViewport(img as HTMLImageElement),
        );
        await Promise.all(initialImages.map(imagePromise));
        // once initial images have loaded, show gallery
        showPage();
      };

      void init();
    </script>

    <script>
      import { initGalleryModal } from "@/components/gallery/galleryModal.ts";

      initGalleryModal();
    </script>
  </body>
</html>
