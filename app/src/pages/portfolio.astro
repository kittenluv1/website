---
import "@/styles/global.css";
import portfolioData from "@/data/portfolio.json";
import PortfolioProject from "@/components/portfolio/PortfolioProject.astro";
import PortfolioModal from "@/components/portfolio/PortfolioModal.astro";
import {
  getAllPortfolioItems,
  type PortfolioData,
} from "@/lib/portfolio";

const data = portfolioData as PortfolioData;
const allItems = getAllPortfolioItems(data);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="erica huang portfolio" />
    <title>erica huang</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-[Inter,sans-serif] text-black antialiased">
    <div
      class="min-h-screen bg-[length:200px_200px] bg-top-left"
      style="background-image: url('/images/portfolio/paper.jpg'), url('/images/portfolio/page-bg.jpg')"
    >
      <!-- banner -->
      <header class="relative h-[356px] w-full overflow-hidden">
        <img
          src="/images/portfolio/bridge.png"
          alt=""
          class="absolute inset-0 size-full object-cover"
        />
        <img
          src="/images/portfolio/mountains.png"
          alt=""
          class="absolute inset-x-0 top-[-71px] h-[572px] w-full object-cover"
        />
      </header>

      <main class="mx-auto max-w-[964px] px-6 pb-16 pt-8 md:px-10">
        <!-- profile -->
        <section class="relative mb-12">
          <div class="relative mb-6 h-[292px] w-[273px] max-w-full">
            <div
              class="absolute left-[11px] top-[25px] size-[245px] rounded-full border border-[#d4d4d4]/60"
              aria-hidden="true"
            />
            <div
              class="absolute left-[22px] top-[36px] size-[223px] rounded-full border border-[#e0e0e0]/80 bg-cover bg-center bg-no-repeat bg-left"
              style="background-image: url('/images/portfolio/doko.jpg')"
              aria-hidden="true"
            />
            <div
              class="absolute left-0 top-1 size-[271px] overflow-hidden"
              style="-webkit-mask-image: url('/images/portfolio/pfp-mask.svg'); mask-image: url('/images/portfolio/pfp-mask.svg'); -webkit-mask-size: 275px 256px; mask-size: 275px 256px; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: 0 15px; mask-position: -1px -1px;"
            >
              <img
                src={data.profile.pfp}
                alt=""
                class="w-full object-cover -translate-y-[15px]"
              />
            </div>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h1 class="text-[36px] font-semibold">{data.profile.name}</h1>
            <p class="text-[24px] font-semibold italic text-[#5e5e5e]">
              {data.profile.pronouns}
            </p>
          </div>

          <p class="mt-4 max-w-[931px] text-[20px] leading-normal text-[#9d9d9d]">
            {data.profile.bio}
          </p>

          <p class="mt-4 text-[20px] text-[#9d9d9d]">
            <span class="underline">ask me about</span>
            {" "}my projects, work, or my love for toro inuoue!
          </p>
        </section>

        <!-- projects -->
        <section class="mb-16">
          <h2 class="mb-8 text-[20px] font-semibold">projects</h2>
          <div
            class="grid grid-cols-1 gap-x-[111px] gap-y-[78px] md:grid-cols-2"
          >
            {
              data.projects.map((project, index) => (
                <PortfolioProject {...project} index={index} />
              ))
            }
          </div>
        </section>

        <!-- playground -->
        <section class="mb-16">
          <h2 class="mb-8 text-[20px] font-semibold">playground</h2>
          <div
            class="grid grid-cols-1 gap-x-[111px] gap-y-[78px] md:grid-cols-2"
          >
            {
              data.playground.map((project, index) => (
                <PortfolioProject
                  {...project}
                  index={data.projects.length + index}
                />
              ))
            }
          </div>
        </section>

        <!-- contact -->
        <footer>
          <p class="text-[24px] font-semibold italic text-[#8e8e93]">
            <span class="font-normal not-italic">Contact:</span>
            {" "}
            <a
              href={`mailto:${data.contact.email}`}
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              Email
            </a>
            {" "}
            <a
              href={data.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              GitHub
            </a>
            {" "}
            <a
              href={data.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              LinkedIn
            </a>
            {" "}
            <a
              href={data.contact.resume}
              target="_blank"
              rel="noopener noreferrer"
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              Resume
            </a>
          </p>
        </footer>
      </main>
    </div>

    <PortfolioModal items={allItems} />
  </body>
</html>
