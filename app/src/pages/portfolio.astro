---
import "@/styles/global.css";
import portfolioData from "@/data/portfolio.json";
import PortfolioProject from "@/components/portfolio/PortfolioProject.astro";
import PortfolioModal from "@/components/portfolio/PortfolioModal.astro";
import {
  getAllPortfolioItems,
  type PortfolioData,
  getRandomPfp,
} from "@/lib/portfolio";

const data = portfolioData as PortfolioData;
const randomPfp = getRandomPfp(data);
const allItems = getAllPortfolioItems(data);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="erica huang portfolio" />
    <title>erica huang</title>
    <link rel="icon" href="/images/portfolio/pfps/toro.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-[Inter,sans-serif] text-black antialiased">
    <div
      class="min-h-screen bg-size-50 bg-top-left"
      style="background-image: url('/images/portfolio/paper.jpg'), url('/images/portfolio/page-bg.jpg')"
    >
      <!-- banner -->
      <header class="absolute h-50 w-full overflow-hidden md:h-96">
        <img
          src="/images/portfolio/banner.jpg"
          alt=""
          class="absolute inset-0 size-full object-cover"
        />
      </header>

      <main class="mx-6 md:mx-auto max-w-5xl px-6 pb-24 pt-8 md:px-10">
        <!-- profile -->
        <section class="relative mb-12 mt-12 md:mt-48">
          <div class="relative mb-6 h-48 md:h-72 w-48 md:w-68 max-w-full">
            <div
              class="absolute left-3 top-6 size-40 md:size-60 rounded-full border border-none"
              style="background-image: url('/images/portfolio/paper.jpg')"
              aria-hidden="true"
            />
            <div
              class="absolute left-5.5 top-9 size-36 md:size-56 rounded-full border border-[#D3D3D3]/80 bg-cover bg-center bg-no-repeat bg-left"
              style="background-image: url('/images/portfolio/doko.jpg')"
              aria-hidden="true"
            />
            <div
              class="absolute left-0 top-1 size-48 overflow-hidden mask-[url('/images/portfolio/pfp-mask.svg')] mask-size-[100%_auto] mask-no-repeat mask-position-[-1px_-2px] md:size-68 md:mask-position-[-1px_2px]"
            >
              <img
                src={randomPfp}
                alt=""
                class="w-full absolute bottom-0 -translate-y-2.5 md:-translate-y-3.5"
              />
            </div>
          </div>

          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h1 class="text-3xl font-semibold md:text-4xl">{data.profile.name}</h1>
            <p class="text-xl font-semibold italic text-[#5e5e5e] md:text-2xl">
              {data.profile.pronouns}
            </p>
          </div>

          <p class="mt-4 max-w-4xl text-lg leading-normal text-[#8e8e93] md:max-w-5xl md:text-xl">
            {data.profile.bio}
          </p>

          <p class="mt-4 text-lg text-[#8e8e93] md:text-xl">
            <a href="#contact" class="underline">ask me about</a>
            {" "}my projects, work, or my love for toro inuoue!
          </p>
        </section>

        <!-- projects -->
        <section class="mb-16">
          <h2 class="mb-8 text-2xl font-semibold md:text-3xl">projects</h2>
          <div
            class="grid grid-cols-1 gap-x-20 gap-y-20 md:grid-cols-2"
          >
            {
              data.projects.map((project, index) => (
                <PortfolioProject {...project} index={index} />
              ))
            }
          </div>
        </section>

        <!-- playground -->
        <section class="mb-16">
          <h2 class="mb-8 text-2xl font-semibold md:text-3xl">playground</h2>
          <div
            class="grid grid-cols-1 gap-x-20 gap-y-20 md:grid-cols-2"
          >
            {
              data.playground.map((project, index) => (
                <PortfolioProject
                  {...project}
                  index={data.projects.length + index}
                />
              ))
            }
          </div>
        </section>

        <!-- contact -->
        <footer>
          <p id="contact" class="text-lg font-semibold italic text-[#8e8e93] md:text-xl">
            <span class="font-normal not-italic">contacts:</span>
            {'\u00A0'}
            <button
              type="button"
              data-copy-email={data.contact.email}
              class="cursor-pointer border-0 bg-transparent p-0 font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              email
            </button>
            {'\u00A0'}
            <a
              href={data.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              github
            </a>
            {'\u00A0'}
            <a
              href={data.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              linkedin
            </a>
            {'\u00A0'}
            <a
              href={data.contact.resume}
              target="_blank"
              rel="noopener noreferrer"
              class="font-normal not-italic text-[#8e8e93] underline transition-colors hover:text-black"
            >
              resume
            </a>
          </p>
        </footer>
      </main>
    </div>

    <PortfolioModal items={allItems} />

    <script>
      function initCopyEmail() {
        document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((button) => {
          if (button.dataset.copyEmailInit === "true") return;
          button.dataset.copyEmailInit = "true";

          button.addEventListener("click", async (e) => {
            const email = button.dataset.copyEmail;
            if (!email) return;

            e.preventDefault();

            try {
              await navigator.clipboard.writeText(email);
            } catch {
              return;
            }

            const tooltip = document.createElement("div");
            tooltip.className = "copy-tooltip";
            tooltip.textContent = "email copied";
            tooltip.setAttribute("role", "status");
            tooltip.setAttribute("aria-live", "polite");
            document.body.appendChild(tooltip);

            const { clientX, clientY } = e;
            tooltip.style.left = `${clientX + 10}px`;
            tooltip.style.top = `${clientY - 10}px`;

            window.setTimeout(() => {
              tooltip.remove();
            }, 1500);
          });
        });
      }

      initCopyEmail();
    </script>

    <style is:global>
      .copy-tooltip {
        position: fixed;
        pointer-events: none;
        z-index: 9999;
        font-size: 0.875rem;
        white-space: nowrap;
        color: white;
        text-shadow: 1px 1px 3px black, 0 0 5px white;
        animation: copy-tooltip-fade-out 1.5s ease forwards;
      }

      @keyframes copy-tooltip-fade-out {
        0% {
          opacity: 1;
          transform: translate(-50%, -120%);
        }
        70% {
          opacity: 1;
          transform: translate(-50%, -120%);
        }
        100% {
          opacity: 0;
          transform: translate(-50%, -140%);
        }
      }
    </style>
  </body>
</html>
