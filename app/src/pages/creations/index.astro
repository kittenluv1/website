---
import { getCategories, type CreationsData } from "@/lib/creations";
import { Image } from "astro:assets";
import creationsData from "@/data/creations.json";
import Layout from "./layout.astro";
import { gridItemButton } from "@/lib/creations";

const categories = getCategories(creationsData as CreationsData);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/creations/**/*.{png,jpg,jpeg,JPEG,webp,gif}",
  { eager: true },
);


---

<Layout pageView="categories">
  {
    categories.map(({ name, slug, preview }) => {
      const image = preview ? images[preview]?.default : undefined;
      if (!image) {
        console.log(preview, "image not found");
        return null;
      }

      return (
        <a
          href={`/creations/${slug}`}
          class={gridItemButton}
        >
          <Image src={image} alt={name} />
          <p>{name}</p>
        </a>
      );
    })
  }
</Layout>
