---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import {
  ALL_CATEGORY_SLUG,
  CREATIONS_ABOUT_TEXT,
  creationsClickableTextButton,
  creationsHomeLink,
  creationsNavCrumbLink,
  creationsNavCrumbText,
  creationsStickerButton,
  creationsStickerLabel,
  creationTilt,
  shortStackFont,
  textShadowGreen,
} from "@/lib/creations";

import buttonCategories from "@/images/creations/button.png";
import buttonAboutBanner from "@/images/creations/about-banner.png";
import buttonAllPieces from "@/images/creations/button4.png";
import buttonHeart from "@/images/creations/button6.png";
import catIcon from "@/images/creations/caticon.png";
import circleLogo from "@/images/creations/circleLogo.png";
import cornerDeco from "@/images/creations/corner.png";
import edgeLace from "@/images/creations/edge.png";
import plaidBg from "@/images/creations/plaid.jpg";
import plaidMain from "@/images/creations/plaid1.jpg";
import stickerCat from "@/images/creations/sticker-cat.png";
import stickerFish from "@/images/creations/sticker-fish.png";
import stickerHamster from "@/images/creations/sticker-hamster.png";
import stickerStar from "@/images/creations/sticker-star.png";
import stickerKamio from "@/images/creations/sticker-kamio.png";

interface Props {
  pageView?: string;
}

const { pageView = "categories" } = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCategoriesIndex = normalizedPath === "/creations";
const isAllPieces = normalizedPath === `/creations/${ALL_CATEGORY_SLUG}`;
const categorySlug =
  !isCategoriesIndex &&
  !isAllPieces &&
  normalizedPath.startsWith("/creations/")
    ? normalizedPath.slice("/creations/".length)
    : null;
const categoryHref = categorySlug ? `/creations/${categorySlug}` : null;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>creations</title>
    <link rel="icon" href={catIcon.src} type="image/png" />
    <ClientRouter />
  </head>
  <body class="m-0 flex h-full min-h-0 overflow-hidden bg-white">
    <aside
      id="creations-sidebar"
      data-view="nav"
      transition:persist="creations-sidebar"
      class="relative z-[1] flex h-full w-[min(100%,16rem)] min-w-[14rem] shrink-0 flex-col items-center overflow-y-auto py-2 sm:overflow-y-hidden"
      style={`background-image: url(${plaidBg.src}); background-size: 6.25rem 6.25rem;`}
    >
      <div class:list={[
          "absolute right-[2%] top-0 z-[2] flex size-14 rotate-12 items-center justify-center sm:size-16",
          creationTilt("right"),
        ]} aria-hidden="true">
        <img
          src={stickerStar.src}
          alt=""
          aria-hidden="true"
          class="size-full object-contain"
        />
      </div>

      <a href="/" class={creationsHomeLink}>
        ← home
      </a>

      <!-- plaid clover circle logo -->
      <div class="relative w-full shrink-0 p-2">
        <div
          class="pointer-events-none absolute left-1/2 top-1/2 flex size-[88%] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full overflow-hidden border-8 border-[#A9C46C]"
        >
          <img
            src={plaidMain.src}
            alt=""
            aria-hidden="true"
            class="size-full -rotate-45 object-cover border-radius-full"
          />
        </div>
        <img
          src={circleLogo.src}
          alt=""
          aria-hidden="true"
          class="relative z-[1] w-full object-contain"
        />
      </div>

      <p
        class:list={[
          shortStackFont,
          "m-0 mb-2 shrink-0 text-3xl text-white sm:text-4xl",
          textShadowGreen,
        ]}
      >
        creations
      </p>

      <div
        data-creations-sidebar-about
        hidden
        class="relative flex w-full min-h-0 flex-1 flex-col items-center px-4 pb-4 sm:px-5"
      >
        <button
          type="button"
          data-sidebar-show="nav"
          class:list={[creationsClickableTextButton, "self-start text-sm sm:text-base"]}
        >
          ← back
        </button>

        <div class="relative flex w-full max-w-[13rem] shrink-0 items-center justify-center pt-2">
          <img
            src={stickerCat.src}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute left-3 top-4 z-[2] w-14 -rotate-8 sm:w-16"
          />
          <div class="relative flex h-16 w-full items-center justify-center sm:h-[4.5rem]">
            <img
              src={buttonAboutBanner.src}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 size-full object-fill"
            />
            <span class:list={[[
              shortStackFont,
              "relative z-[1] text-center text-base font-normal text-white underline underline-offset-2 pl-12",
              textShadowGreen,
            ]]}>about</span>
          </div>
        </div>

        <p
          class:list={[
            shortStackFont,
            "m-0 mt-2 w-full text-center text-xs leading-relaxed text-black sm:text-sm"
          ]}
        >
          {CREATIONS_ABOUT_TEXT}
        </p>
      </div>

      <div
        data-creations-sidebar-nav
        class="relative min-h-[22rem] w-full flex-1 sm:min-h-[26rem]"
      >
        <a
          href={`/creations/${ALL_CATEGORY_SLUG}`}
          data-astro-prefetch
          class:list={[
            creationsStickerButton,
            creationTilt("left"),
            "-rotate-8 left-[8%] top-0 size-[6.5rem] sm:size-[7rem]",
          ]}
          aria-label="all pieces"
        >
          <img
            src={buttonAllPieces.src}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 size-full object-contain"
          />
          <span class={creationsStickerLabel}>all pieces</span>
        </a>

        <a
          href="/creations"
          data-astro-prefetch
          class:list={[
            creationsStickerButton,
            creationTilt("right"),
            "rotate-[7deg] left-[38%] top-[9.5rem] size-[6.5rem] sm:left-[42%] sm:top-[10.5rem] sm:size-[7rem]",
          ]}
          aria-label="categories"
        >
          <img
            src={buttonCategories.src}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 object-fit opacity-90"
          />
          <span class={creationsStickerLabel}>categories</span>
        </a>

        <button
          type="button"
          data-sidebar-show="about"
          class:list={[
            creationsStickerButton,
            creationTilt("left"),
            "-rotate-6 left-[8%] top-[19.5rem] size-[6.5rem] sm:top-[21rem] sm:size-[7rem]",
          ]}
          aria-label="about"
        >
          <img
            src={buttonHeart.src}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 size-full object-contain"
          />
          <span class={creationsStickerLabel}>about</span>
        </button>

        <img
          src={stickerCat.src}
          alt=""
          aria-hidden="true"
          class:list={[
            creationTilt(0),
            "absolute -rotate-8 left-[7%] top-[16rem] w-16 sm:top-[17.5rem] sm:w-[4.25rem]",
          ]}
        />
        <img
          src={stickerKamio.src}
          alt=""
          aria-hidden="true"
          class:list={[
            creationTilt(1),
            "absolute rotate-[13deg] right-[4%] top-[3%] w-14 sm:w-16",
          ]}
        />
        <img
          src={stickerFish.src}
          alt=""
          aria-hidden="true"
          class:list={[
            creationTilt(2),
            "absolute -scale-y-100 rotate-[16deg] left-[14%] top-[7.5rem] w-24 sm:w-[6rem]",
          ]}
        />
        <img
          src={stickerHamster.src}
          alt=""
          aria-hidden="true"
          class:list={[
            creationTilt(3),
            "absolute rotate-[23deg] right-[8%] top-[23.5rem] w-16 sm:top-[25rem] sm:w-[4.25rem]",
          ]}
        />
      </div>
    </aside>

    <!-- main -->
    <div
      id="creations-main"
      transition:animate="fade"
      class="relative z-[1] flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
      style={`background-image: url(${plaidMain.src}); background-size: 9.375rem 9.375rem;`}
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 left-0 top-0 flex w-[4.5rem] flex-col sm:w-[5.5rem] md:w-[7rem]"
      >
        <img
          src={edgeLace.src}
          alt=""
          class="h-1/3 w-full object-cover object-left"
        />
        <img
          src={edgeLace.src}
          alt=""
          class="h-1/3 w-full -scale-y-100 object-cover object-left"
        />
        <img
          src={edgeLace.src}
          alt=""
          class="h-1/3 w-full object-cover object-left"
        />
      </div>

      <img
        src={cornerDeco.src}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 right-0 hidden w-28 object-contain sm:block md:w-36"
      />

      <div
        id="creations-scroll"
        class="relative z-[1] flex min-h-0 flex-1 flex-col overflow-y-auto pl-[1rem] sm:pl-[2rem] md:pl-[3rem]"
      >
        <nav
          class="sticky top-0 z-[3] px-6 py-3 sm:px-12 sm:py-4 md:px-15"
          aria-label="Breadcrumb"
        >
          <ol
            id="creation-breadcrumb"
            class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0"
            data-link-class={creationsNavCrumbLink}
          >
            {
              isAllPieces ? (
                <li>
                  <a
                    href={`/creations/${ALL_CATEGORY_SLUG}`}
                    class={creationsNavCrumbLink}
                    data-astro-prefetch
                    data-creation-breadcrumb-root
                    aria-current="page"
                  >
                    all pieces
                  </a>
                </li>
              ) : isCategoriesIndex ? (
                <li>
                  <a
                    href="/creations"
                    class={creationsNavCrumbLink}
                    data-astro-prefetch
                    data-creation-breadcrumb-root
                    aria-current="page"
                  >
                    categories
                  </a>
                </li>
              ) : (
                <>
                  <li>
                    <a href="/creations" class={creationsNavCrumbLink} data-astro-prefetch>
                      categories
                    </a>
                  </li>
                  <li class={creationsNavCrumbText} aria-hidden="true">/</li>
                  <li>
                    <a
                      href={categoryHref!}
                      class={creationsNavCrumbLink}
                      data-astro-prefetch
                      data-creation-breadcrumb-root
                      aria-current="page"
                    >
                      {pageView}
                    </a>
                  </li>
                </>
              )
            }
            <li
              id="creation-breadcrumb-sep"
              class:list={[creationsNavCrumbText, "hidden"]}
              aria-hidden="true"
            >
              /
            </li>
            <li id="creation-breadcrumb-piece-li" class="hidden">
              <a
                id="creation-breadcrumb-piece-link"
                class={creationsNavCrumbLink}
                data-astro-prefetch
              />
            </li>
          </ol>
        </nav>

        <div id="creations-content" class="relative z-[2] flex min-h-0 flex-1 flex-col">
          <button
            type="button"
            id="creation-modal-backdrop"
            hidden
            class="fixed z-[15] cursor-default border-0 bg-white/70 p-0 opacity-0 pointer-events-none transition-opacity duration-200 data-[open]:pointer-events-auto data-[open]:opacity-60 ml-20"
            aria-label="Close dialog"
            aria-hidden="true"
          ></button>
          <div
            id="creations-grid"
            class="relative z-10 grid grid-cols-2 gap-6 px-6 pb-8 sm:grid-cols-3 sm:gap-8 sm:px-10 md:px-12 md:pb-12 lg:grid-cols-4"
          >
            <slot />
          </div>
          <slot name="extra" />
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "short-stack-regular";
    src: url("https://fonts.gstatic.com/s/shortstack/v16/bMrzmS2X6p0jZC6EcmPFX-SS.ttf")
      format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "messy-handwritten";
    src: url("/fonts/MessyHandwritten/MessyHandwritten-Regular.ttf")
      format("truetype");
  }
</style>

<script>
  import { initCreationsSidebar } from "@/components/creations/creationsSidebar.ts";
  initCreationsSidebar();
</script>
