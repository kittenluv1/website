---
import creationsData from "@/data/creations.json";
import {
  ALL_CATEGORY_SLUG,
  getAllCreations,
  getCategories,
  getCreationImage,
  getCreationImageUrl,
  type Creation,
  type CreationsData,
  type FlatCreation,
  gridItemButton,
} from "@/lib/creations";
import CreationModal, {
  type CreationModalItem,
} from "@/components/creations/CreationModal.astro";
import { Image } from "astro:assets";
import Layout from "./layout.astro";

export function getStaticPaths() {
  const categories = getCategories(creationsData as CreationsData);

  return [
    ...categories.map(({ name, slug }) => ({
      params: { category: slug },
      props: { categoryName: name, isAll: false },
    })),
    {
      params: { category: ALL_CATEGORY_SLUG },
      props: { categoryName: "all pieces", isAll: true },
    },
  ];
}

interface Props {
  categoryName: string;
  isAll: boolean;
}

const { categoryName, isAll } = Astro.props;

const items: (Creation | FlatCreation)[] = isAll
  ? getAllCreations(creationsData as CreationsData)
  : ((creationsData as CreationsData)[categoryName] ?? []);

if (!items.length) {
  return Astro.redirect("/creations");
}

function getItemCategoryName(item: Creation | FlatCreation) {
  return "categoryName" in item ? item.categoryName : undefined;
}

const modalItems: CreationModalItem[] = items.map((item) => ({
  title: item.title,
  date: item.date,
  description: item.description,
  comments: item.comments,
  categoryName: getItemCategoryName(item),
  imageUrls: item.images.map(getCreationImageUrl),
  captions: item.captions ?? [],
}));
---

<Layout pageView={categoryName}>
  {
    items.map((item, index) => {
      const imageSrc = item.images?.[0];
      const image = getCreationImage(imageSrc);
      const itemCategoryName = getItemCategoryName(item);

      if (!image) {
        console.warn(`[creations] image not found: ${imageSrc} (${item.title})`);
      }

      return (
        <button type="button" data-creation-item={index} class={gridItemButton}>
          {
            image ? (
              <Image src={image} alt={item.title} />
            ) : (
              <div
                aria-hidden="true"
                class="box-border flex aspect-square h-full w-full items-center justify-center pb-[1vh] opacity-50"
              />
            )
          }
          <p class="mb-0!">{item.title}</p>
          {itemCategoryName && (
            <p class="m-0! text-sm">{itemCategoryName}</p>
          )}
        </button>
      );
    })
  }

  <div slot="extra">
    <CreationModal items={modalItems} />
  </div>
</Layout>
