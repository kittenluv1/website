---
import {
  getCategories,
  getCreationImage,
  getCreationImageUrl,
  type CreationsData,
} from "@/lib/creations";
import { Image } from "astro:assets";
import creationsData from "@/data/creations.json";
import Layout from "./layout.astro";
import { gridItemButton } from "@/lib/creations";

const categories = getCategories(creationsData as CreationsData);
---

<Layout pageView="categories">
  {
    categories.map(({ name, slug, preview }) => {
      const image = getCreationImage(preview);
      const imageUrl = preview ? getCreationImageUrl(preview) : undefined;
      if (!image) {
        console.warn(
          `[creations] optimized preview unavailable, using URL fallback: ${preview} (${name})`,
        );
      }

      return (
        <a
          href={`/creations/${slug}`}
          class={gridItemButton}
        >
          {
            image ? (
              <Image src={image} alt={name} />
            ) : imageUrl ? (
              <img
                src={imageUrl}
                alt={name}
                onerror="this.style.display='none'"
              />
            ) : (
              <div
                aria-hidden="true"
                class="box-border flex aspect-square h-full w-full items-center justify-center pb-[1vh] opacity-50"
              />
            )
          }
          <p>{name}</p>
        </a>
      );
    })
  }
</Layout>
