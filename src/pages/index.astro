---
import "@/styles/global.css";
import Modal from "../components/index/modal.astro";
import { Image } from "astro:assets";
import IndexButton from "../components/index/indexButton.astro";
import type { ImageMetadata } from "astro";

// image imports
import backgroundImgSrc from "@/images/index/index.jpg";
import blogImgSrc from "@/images/index/lotus.png";
import creationsImgSrc from "@/images/index/clover.png";
import japanImgSrc from "@/images/index/japan.png";
import portfolioImgSrc from "@/images/index/toro.png";
import resourcesImgSrc from "@/images/index/tool.png";
import writingImgSrc from "@/images/index/writing.png";
import detectiveImgSrc from "@/images/index/detective.png";
import galleryImgSrc from "@/images/index/tarepanda1.png";
import flappyImgSrc from "@/images/index/kuchipatchi.png";
import neocitiesImgSrc from "@/images/index/treble-cat.png";
import microblogImgSrc from "@/images/index/heart-cookie.png";
import musicImgSrc from "@/images/index/mametchi.png";
import flyingToroImgSrc from "@/images/index/flyingtoro.png";
import startImgSrc from "@/images/index/start.png";
import archiveImgSrc from "@/images/index/archive.png";

const textShadow =
  "[text-shadow:-1px_-1px_0_#555555,1px_-1px_0_#555555,-1px_1px_0_#555555,1px_1px_0_#555555,0px_0px_2px_black]";

const footerGradient =
  "linear-gradient(rgb(31, 47, 134) 0px, rgb(49, 101, 196) 3%, rgb(54, 130, 229) 6%, rgb(68, 144, 230) 10%, rgb(56, 131, 229) 12%, rgb(43, 113, 224) 15%, rgb(38, 99, 218) 18%, rgb(35, 91, 214) 20%, rgb(34, 88, 213) 23%, rgb(33, 87, 214) 38%, rgb(36, 93, 219) 54%, rgb(37, 98, 223) 86%, rgb(36, 95, 220) 89%, rgb(33, 88, 212) 92%, rgb(29, 78, 192) 95%, rgb(25, 65, 165) 98%)";

interface IndexButtonData {
  img: ImageMetadata;
  text: string;
  href: string;
  class: string;
}

const indexButtons: IndexButtonData[] = [
  {
    img: creationsImgSrc,
    text: "creations",
    href: "/creations",
    class: "md:[grid-row-start:1] md:[grid-column-start:1]",
  },
  {
    img: japanImgSrc,
    text: "japan tv",
    href: "/japan-tv",
    class: "md:[grid-row-start:1] md:[grid-column-start:2]",
  },
  {
    img: portfolioImgSrc,
    text: "portfolio",
    href: "/portfolio",
    class: "md:[grid-row-start:1] md:[grid-column-start:3]",
  },
  {
    img: musicImgSrc,
    text: "play",
    href: "music",
    class: "md:[grid-row-start:5] md:[grid-column-start:2]",
  },
  {
    img: writingImgSrc,
    text: "writing",
    href: "/writing",
    class: "md:[grid-row-start:6] md:[grid-column-start:2]",
  },
  {
    img: microblogImgSrc,
    text: "microblog",
    href: "/microblog",
    class: "md:[grid-row-start:7] md:[grid-column-start:2]",
  },
  {
    img: blogImgSrc,
    text: "nostalgiablog",
    href: "/blog/2026",
    class: "md:[grid-row-start:5] md:[grid-column-start:11]",
  },
  {
    img: galleryImgSrc,
    text: "gallery",
    href: "/gallery",
    class: "md:[grid-row-start:6] md:[grid-column-start:7]",
  },
  {
    img: neocitiesImgSrc,
    text: "neocities",
    href: "https://kittenluv1.neocities.org/",
    class: "md:[grid-row-start:6] md:[grid-column-start:11]",
  },
  {
    img: resourcesImgSrc,
    text: "resources",
    href: "https://kittenluv1.neocities.org/resources",
    class: "md:[grid-row-start:6] md:[grid-column-start:12]",
  },
  {
    img: flappyImgSrc,
    text: "flappypatchi",
    href: "https://introspec.itch.io/flappypatchi",
    class: "md:[grid-row-start:3] md:[grid-column-start:14]",
  },
  {
    img: detectiveImgSrc,
    text: "detective",
    href: "https://introspec.itch.io/dimensional-detective",
    class: "md:[grid-row-start:4] md:[grid-column-start:14]",
  },
  {
    img: archiveImgSrc,
    text: "archive",
    href: "/archive",
    class: "md:[grid-row-start:8] md:[grid-column-start:16]",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>kittenluv1</title>
    <link rel="icon" href={backgroundImgSrc.src} type="image/jpeg" />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/counterapi/dist/counter.browser.min.js"
    ></script>
    <script is:inline defer>
      // Counter is available as a global variable
      const counter = new Counter({ workspace: "kittenluv1" });

      counter
        .up("kittenluv1-visits")
        .then((result) => {
          console.log("Counter result:", result);
          document.getElementById("counter").textContent = result.data.up_count;
        })
        .catch((err) => console.error(err));
    </script>
  </head>
  <body
    class={`font-[Tahoma,Verdana,sans-serif] text-sm text-white md:text-[2vh] ${textShadow}`}
  >
    <div class="relative h-[95vh] w-screen">
      <Image
        src={backgroundImgSrc}
        alt=""
        loading="eager"
        fetchpriority="high"
        sizes="100vw"
        class="absolute inset-0 z-0 h-full w-full object-cover"
      />

      <div
        class="relative z-10 grid h-full w-full grid-cols-4 grid-rows-4 gap-2 p-3 md:grid-cols-[repeat(16,1fr)] md:grid-rows-[repeat(8,1fr)] md:gap-0 md:p-0"
      >
        {
          indexButtons.map((button) => (
            <IndexButton
              img={button.img}
              text={button.text}
              href={button.href}
              class={button.class}
            />
          ))
        }
      </div>
    </div>

    <Modal />

    <!-- WINDOWS XP FOOTER -->
    <footer
      class="z-1 flex h-[5vh] items-center"
      style={`background: ${footerGradient}`}
    >
      <Image
        src={startImgSrc}
        alt=""
        width="100"
        class="h-full w-auto opacity-80"
      />
      <div class="absolute right-0 flex h-[3vh] items-center *:mr-2">
        <div>visits: <span id="counter"></span></div>
        <p>&copy; e**** 2024</p>
        <Image
          src={flyingToroImgSrc}
          alt="flying toro"
          width="100"
          class="h-full w-auto opacity-80"
        />
      </div>
    </footer>
  </body>

  <script define:vars={{ footerGradient }}>
    // ========================== FOOTER GRADIENTS ========================= //
    const footer = document.querySelector("footer");
    const gradients = [
      footerGradient,
      `linear-gradient(
    rgb(255, 225, 235) 0px,
    rgb(255, 215, 225) 3%,
    rgb(255, 210, 220) 6%,
    rgb(255, 205, 215) 10%,
    rgb(255, 210, 220) 12%,
    rgb(255, 220, 230) 15%,
    rgb(255, 225, 235) 18%,
    rgb(255, 230, 240) 20%,
    rgb(255, 235, 245) 23%,
    rgb(255, 240, 245) 38%,
    rgb(255, 235, 240) 54%,
    rgb(255, 230, 235) 86%,
    rgb(255, 235, 240) 89%,
    rgb(255, 240, 245) 92%,
    rgb(255, 245, 250) 95%,
    rgb(255, 250, 255) 98%
  )`,
      `linear-gradient(
    rgb(150, 180, 255) 0px,
    rgb(170, 200, 255) 3%,
    rgb(180, 210, 255) 6%,
    rgb(190, 220, 255) 10%,
    rgb(185, 215, 255) 12%,
    rgb(175, 205, 255) 15%,
    rgb(165, 195, 255) 18%,
    rgb(160, 190, 255) 20%,
    rgb(158, 188, 255) 23%,
    rgb(157, 187, 255) 38%,
    rgb(160, 192, 255) 54%,
    rgb(162, 195, 255) 86%,
    rgb(160, 193, 255) 89%,
    rgb(157, 187, 255) 92%,
    rgb(150, 180, 240) 95%,
    rgb(140, 170, 220) 98%
  )`,
    ];

    // Track the current index instead of color names
    let currentIndex = 0;

    footer.addEventListener("click", () => {
      // Increment index and wrap around using modulo
      currentIndex = (currentIndex + 1) % gradients.length;
      footer.style.background = gradients[currentIndex];
    });
  </script>
</html>
